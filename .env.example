# Supabase（Settings → API）。呢兩條係 public，VITE_ 前綴會打入瀏覽器，呢個係預期。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 以下三條只可以俾 server 讀。唔好加 VITE_ 前綴，否則會打包進前端。
# 本機 `npm run dev` 同 Vercel Functions 都讀呢三個名。
# 留空 = 對應功能停用（航班／TomTom／收據 OCR 自動降級），唔會當機。

# 航班查詢（AviationStack）。https://aviationstack.com
AVIATIONSTACK_KEY=

# TomTom Search + Routing（地點搜尋 fallback、步行／自駕）。https://developer.tomtom.com
TOMTOM_KEY=

# Taggun 收據 OCR。https://taggun.io
TAGGUN_API_KEY=

# 電車：冇免信用卡嘅公共交通 routing API，改用 Google Maps 連結，唔使 key。
# 便利店／洗手間／雨天室內推介用 OpenStreetMap Overpass，完全免 key。
